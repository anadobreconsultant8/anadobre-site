---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const canonicalUrl = 'https://anadobre.com/abc/automatizari-marketing-vanzari';
const title = 'Ce înseamnă, de fapt, automatizările de marketing și vânzări?';
const dateISO = new Date('2026-08-12').toISOString();

const faqs = [
  {
    question: 'Ce sunt automatizările de marketing și vânzări?',
    answer:
      'Sunt fluxuri prin care un software execută și coordonează automat pași din procesul comercial atunci când apare un eveniment sau este îndeplinită o condiție. Pot muta date, trimite mesaje, crea task-uri, direcționa lead-uri și opri sau ramifica procesul după reguli stabilite.',
  },
  {
    question: 'Cum îți automatizezi vânzările?',
    answer:
      'Pornești de la un punct în care pierzi timp sau oportunități, măsori situația actuală și definești regula, datele, excepțiile și rezultatul urmărit. Construiești un singur flow, îl testezi inclusiv pe cazurile în care ceva lipsește sau eșuează și îl extinzi numai după ce indicatorul ales se îmbunătățește.',
  },
  {
    question: 'Ce poți automatiza în marketing?',
    answer:
      'Poți automatiza captarea și segmentarea lead-urilor, emailurile declanșate de comportamente sau date, nurturingul, handoff-ul către vânzări, actualizarea CRM-ului, solicitările de feedback și raportarea. Cele mai bune puncte de pornire sunt pașii repetitivi, cu reguli stabile, date disponibile și un rezultat măsurabil.',
  },
  {
    question: 'Automatizările au nevoie de AI?',
    answer:
      'Nu. Multe automatizări funcționează foarte bine doar cu reguli de tip „dacă X, atunci Y". AI-ul poate fi adăugat într-un anumit pas când trebuie interpretat un text, estimat un rezultat sau generat un răspuns, dar nu este o condiție pentru automatizare.',
  },
  {
    question: 'Configurezi o automatizare o singură dată?',
    answer:
      'Nu. După lansare trebuie urmărite execuțiile, erorile și rezultatele. Regulile, mesajele, permisiunile și integrările se actualizează atunci când se schimbă procesul, oferta, echipa sau platformele conectate.',
  },
  {
    question: 'Este deschiderea unui email un trigger bun?',
    answer:
      'Poate fi un semnal secundar, dar nu este suficient de sigur pentru o decizie importantă. Funcțiile de confidențialitate ale aplicațiilor de email pot încărca automat conținutul. Clickul, răspunsul, formularul completat sau schimbarea de status în CRM sunt semnale mai apropiate de o acțiune reală.',
  },
  {
    question: 'De unde începi cu automatizările?',
    answer:
      'Începi de la un punct în care un lead așteaptă, o informație se pierde sau echipa repetă manual același pas. Măsori situația actuală, definești inclusiv excepțiile și ieșirea din flow, testezi pe cazuri reale și extinzi doar dacă timpul, calitatea sau conversia se îmbunătățesc.',
  },
];
---
<Layout
  title="Ce sunt automatizările de marketing și vânzări? | Ana Dobre"
  description="Ce înseamnă automatizările de marketing și vânzări, cum funcționează și la ce te ajută concret în business. Explicat pe înțelesul unui antreprenor."
  canonical={canonicalUrl}
  ogImage="/og-abc-automatizari-marketing-vanzari.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": `${canonicalUrl}#article`,
        "headline": title,
        "description": "Ce înseamnă automatizările de marketing și vânzări, cum funcționează și la ce te ajută concret în business.",
        "url": canonicalUrl,
        "datePublished": dateISO,
        "dateModified": dateISO,
        "image": "https://anadobre.com/og-abc-automatizari-marketing-vanzari.jpg",
        "inLanguage": "ro",
